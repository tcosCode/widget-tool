---

---

<section class="widget-tester">
  <h1>WIDGET TOOLS</h1>

  <div class="input-section">
    <label for="widget-input">Pega el código aquí:</label>
    <textarea id="widget-input" placeholder="código del widget..." rows="4"
    ></textarea>
    <button id="load-widget">Cargar Widget</button>
    <div id="error-message" class="error hidden">Código inválido</div>
  </div>

  <div id="widget-container" class="widget-container"></div>
</section>

<style>
  * {
    box-sizing: border-box;
  }

  .widget-tester {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  h1 {
    color: #333;
    margin: 0 0 1rem 0;
    font-size: 2.5rem;
    text-align: center;
    font-weight: 700;
  }

  .input-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: white;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  label {
    font-weight: 600;
    color: #555;
    font-size: 1rem;
  }

  textarea {
    padding: 1rem;
    border: 2px solid #ddd;
    border-radius: 8px;
    font-family: "Courier New", monospace;
    font-size: 0.9rem;
    resize: vertical;
    transition: border-color 0.2s;
  }

  textarea:focus {
    outline: none;
    border-color: #4caf50;
  }

  button {
    width: "fit-content";
    margin: 0 auto;
    padding: 1rem 2rem;
    background-color: #4caf50;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.2s,
      transform 0.1s;
  }

  button:hover {
    background-color: #45a049;
  }

  button:active {
    transform: scale(0.98);
  }

  .error {
    padding: 1rem;
    background-color: #ffebee;
    color: #c62828;
    border-radius: 8px;
    font-weight: 600;
    border-left: 4px solid #c62828;
  }

  .hidden {
    display: none;
  }

  .widget-container {
    min-height: 500px;
    padding: 2rem;
    border: 2px dashed #ddd;
    border-radius: 12px;
    background-color: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .widget-container:empty::before {
    content: "El widget aparecerá aquí...";
    color: #999;
    font-style: italic;
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 1.75rem;
    }

    .input-section {
      padding: 1.5rem;
    }

    textarea {
      font-size: 0.85rem;
    }

    button {
      padding: 0.875rem 1.5rem;
      font-size: 1rem;
    }

    .widget-container {
      min-height: 350px;
      padding: 1.5rem;
    }

    .widget-container:empty::before {
      font-size: 1rem;
    }
  }
</style>

<script>
  interface WidgetValidation {
    isValid: boolean;
    div?: string;
    scriptSrc?: string;
    widgetId?: string;
  }

  function validateAndExtractWidget(code: string): WidgetValidation {
    const cleanCode = code.trim();

    // Regex para extraer el div con id y data-widget-id
    const divRegex =
      /<div\s+id=["']btp-valuation-widget["']\s+data-widget-id=["']([a-f0-9-]{36})["']\s*><\/div>/i;

    // Regex para validar que el script sea SOLO de cdn.betipo.es
    const scriptRegex =
      /<script\s+src=["'](https:\/\/cdn\.betipo\.es\/[a-zA-Z0-9_-]+\.js)["']\s*><\/script>/i;

    const divMatch = cleanCode.match(divRegex);
    const scriptMatch = cleanCode.match(scriptRegex);

    if (!divMatch || !scriptMatch) {
      return { isValid: false };
    }

    return {
      isValid: true,
      div: divMatch[0],
      scriptSrc: scriptMatch[1],
      widgetId: divMatch[1],
    };
  }

  function showError() {
    const errorMessage = document.getElementById(
      "error-message"
    ) as HTMLDivElement;
    errorMessage.classList.remove("hidden");

    // Ocultar error después de 4 segundos
    setTimeout(() => {
      errorMessage.classList.add("hidden");
    }, 4000);
  }

  function loadWidget() {
    const input = document.getElementById(
      "widget-input"
    ) as HTMLTextAreaElement;
    const container = document.getElementById(
      "widget-container"
    ) as HTMLDivElement;
    const errorMessage = document.getElementById(
      "error-message"
    ) as HTMLDivElement;
    const button = document.getElementById("load-widget") as HTMLButtonElement;

    errorMessage.classList.add("hidden");

    const code = input.value;
    const validation = validateAndExtractWidget(code);

    if (!validation.isValid) {
      showError();
      return;
    }

    container.innerHTML = "";

    const widgetDiv = document.createElement("div");
    widgetDiv.id = "btp-valuation-widget";
    widgetDiv.setAttribute("data-widget-id", validation.widgetId!);
    container.appendChild(widgetDiv);

    const script = document.createElement("script");
    script.src = validation.scriptSrc!;
    script.async = true;

    script.onerror = () => {
      showError();
      container.innerHTML = "";
    };

    container.appendChild(script);

    // Cambiar texto del botón después de la primera carga
    button.textContent = "Recargar Widget";
  }

  document.getElementById("load-widget")?.addEventListener("click", loadWidget);

  document.getElementById("widget-input")?.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      loadWidget();
    }
  });
</script>
